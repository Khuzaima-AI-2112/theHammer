{
  "manifest_version": 3,
  "name": "The Hammer",
  "version": "0.1.0",
  "description": "One-click screenshot capture with project/user metadata.",
  "permissions": ["activeTab", "storage", "scripting", "notifications", "tabs", "alarms", "offscreen", "contextMenus", "identity"],
  "commands": {
    "capture-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture and log screenshot"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "128": "icons/icon128.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
