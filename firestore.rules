rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the caller a Cloud Run service account? ──────────
    // During Sprint 21, the backend accesses Firestore exclusively via
    // the firebase-admin SDK with Application Default Credentials (ADC).
    // All client-side SDK access is disallowed.
    //
    // These rules deny ALL client reads and writes.
    // The backend uses the Admin SDK which bypasses security rules entirely.
    //
    // Sprint 21 TODO: once Firebase Auth is evaluated (arch_questions.md),
    // revisit per-collection client rules for any direct SDK access patterns.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
